# Copy to .env and adjust. Every value is optional.
# DATABASE_URL=postgresql+psycopg2://ipopilot:secret@localhost:5432/ipopilot   # default: SQLite in data/
# IPOPILOT_DATA_DIR=./data
# IPOPILOT_CORS_ORIGINS=http://localhost:3000
# IPOPILOT_ENABLE_SCHEDULER=1          # background refresh inside the API process
# IPOPILOT_REFRESH_MINUTES=30          # live refresh cadence in market hours
# IPOPILOT_MIN_REQUEST_INTERVAL=1.0    # polite scraping: seconds between requests per host
# IPOPILOT_SELL_COST_PCT=0.25          # selling costs (% of sale value) used by the optimizer
# IPOPILOT_SENTIMENT_MODEL=ProsusAI/finbert
# IPOPILOT_ADMIN_KEY=change-me         # protects POST /api/admin/refresh
# Frontend (frontend/.env.local):
# BACKEND_URL=http://127.0.0.1:8000
